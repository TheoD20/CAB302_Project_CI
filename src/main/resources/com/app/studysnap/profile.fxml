<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane stylesheets="@styles/profile.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.app.studysnap.controllers.ProfileController">

    <StackPane prefHeight="600" prefWidth="900" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <VBox spacing="25" styleClass="page">
            <Label styleClass="title" text="My Profile" />

            <HBox spacing="25">
                <!-- Avatar / Lado izquierdo -->
                <VBox alignment="CENTER" prefWidth="220" spacing="10" styleClass="card">
                    <ImageView fitHeight="96" fitWidth="96" preserveRatio="true" styleClass="avatar" />
                    <Label fx:id="displayName" styleClass="display-name" text="User" />
                    <Label fx:id="providerLabel" styleClass="provider" text="Local account" />
                </VBox>

                <!-- Formulario / Lado derecho -->
                <VBox spacing="18" styleClass="card" HBox.hgrow="ALWAYS">
                    <GridPane hgap="12" vgap="14">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="28" />
                            <ColumnConstraints percentWidth="72" />
                        </columnConstraints>

                        <Label styleClass="field-label" text="Username:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="usernameField" promptText="Enter your username" styleClass="profile-field" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label styleClass="field-label" text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <TextField fx:id="emailField" promptText="you@example.com" styleClass="profile-field" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label styleClass="field-label" text="Provider:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <Label fx:id="providerValue" styleClass="provider-value" text="LOCAL" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <rowConstraints>
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                  </rowConstraints>
                    </GridPane>

                    <HBox alignment="CENTER_RIGHT" spacing="10">
                        <Label fx:id="statusLabel" styleClass="status" text="" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="deleteButton" defaultButton="true" onAction="#handleDeleteProfile" styleClass="delete-btn" text="Delete Profile" />
                        <Button fx:id="saveButton" defaultButton="true" onAction="#handleSave" styleClass="primary-btn" text="Save Changes" />
                    </HBox>
                </VBox>
            </HBox>
        </VBox>
    </StackPane>
</AnchorPane>
