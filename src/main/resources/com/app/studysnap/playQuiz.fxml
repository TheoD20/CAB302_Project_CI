<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.app.studysnap.controllers.PlayQuizPageController"
            stylesheets="@styles/quizPlay.css"
            prefWidth="1100.0" prefHeight="760.0">

   <top>
      <HBox spacing="12" alignment="CENTER_LEFT" BorderPane.alignment="CENTER" styleClass="topbar">
         <children>
            <VBox>
               <Label fx:id="quizTitle" text="Quiz Title" styleClass="title"/>
               <Label fx:id="quizSubtitle" text="Quiz Subtitle" styleClass="subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="quizTimer" text="00:00:00" styleClass="counter timer-badge"/>
         </children>
         <padding>
            <Insets top="12" right="16" bottom="12" left="16"/>
         </padding>
      </HBox>
   </top>

   <center>
      <ScrollPane fitToWidth="true" BorderPane.alignment="CENTER">
         <content>
            <VBox fx:id="questionLayout" spacing="14" styleClass="q-list"/>
         </content>
      </ScrollPane>
   </center>

   <bottom>
      <HBox alignment="CENTER" spacing="8" BorderPane.alignment="CENTER" styleClass="bottom">
         <children>
            <Button text="Submit" onAction="#handleSubmit" styleClass="primary-btn"/>
            <Button fx:id="cancelButton" text="Cancel" onAction="#handleCancel" styleClass="cancel-btn"/>
         </children>
         <padding>
            <Insets top="12" right="16" bottom="16" left="16"/>
         </padding>
      </HBox>
   </bottom>

</BorderPane>