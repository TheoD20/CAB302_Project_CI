<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="root"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.app.studysnap.controllers.QuestionController"
            stylesheets="@styles/question.css"
            prefWidth="720.0"
            styleClass="q-card">

    <children>
        <VBox spacing="8.0"
              fillWidth="true"
              AnchorPane.topAnchor="12.0"
              AnchorPane.leftAnchor="12.0"
              AnchorPane.rightAnchor="12.0"
              AnchorPane.bottomAnchor="12.0">

            <Label fx:id="question_content"
                   styleClass="review-q"
                   wrapText="true"
                   maxWidth="Infinity"
                   textOverrun="CLIP"
                   text="Question text"/>

            <VBox fx:id="optionsBox" spacing="6.0" fillWidth="true">
                <RadioButton fx:id="option1" wrapText="true" maxWidth="Infinity" />
                <RadioButton fx:id="option2" wrapText="true" maxWidth="Infinity" />
                <RadioButton fx:id="option3" wrapText="true" maxWidth="Infinity" />
                <RadioButton fx:id="option4" wrapText="true" maxWidth="Infinity" />
                <RadioButton fx:id="option5" wrapText="true" maxWidth="Infinity" />
            </VBox>

            <Label fx:id="correctFooter"
                   text="Correct answer: "
                   visible="false"
                   managed="false"
                   wrapText="true"
                   maxWidth="Infinity"
                   styleClass="correct-footer"/>
        </VBox>
    </children>
</AnchorPane>